config MMU_TYPE_PRUSA_MMU3_3_0
  bool "Prusa MMU3"
  select LINEAR_IDLER_SELECTOR
  select MMU_HAS_SENSOR_SHARED_EXIT
  select UNSELECT_MMU_HAS_LEDS        # MMU3 LEDs are on the SHR16 shift register (custom setup)
  select UNSELECT_MMU_HAS_ENCODER
  select UNSELECT_MMU_HAS_ESPOOLER
  select UNSELECT_MMU_HAS_FILAMENT_BUFFER
  select UNSELECT_CREATE_MCU_ENVIRONMENT_SENSORS  # ATmega32U4 has no MCU temperature sensor

  select UNSELECT_VARIABLE_BOWDEN_LENGTHS # Disable
  select UNSELECT_FILAMENT_ALWAYS_GRIPPED # Disable


if MMU_TYPE_PRUSA_MMU3_3_0

  config PARAM_VENDOR
    default "Prusa"
  config PARAM_VERSION
    default "3.0"
  config PARAM_NUM_GATES
    default 5
  config PARAM_DESIGN_NUM_GATES
    default 5

  choice BOARD_TYPE
    default BOARD_TYPE_PRUSA_MMU3_1_0
  endchoice

  # The MMU3 has three fixed TMC2130s on the hardware SPI bus. Gear and
  # selector use the shared TMC driver component (chip picked by choice);
  # the idler keeps its own PARAM_IDLER_TMC in Kconfig.idler_stepper
  choice CHOICE_GEAR_TMC
    default CHOICE_GEAR_TMC2130
  endchoice
  choice CHOICE_SELECTOR_TMC
    default CHOICE_SELECTOR_TMC2130
  endchoice
  config PARAM_GEAR_SPI_BUS
    default "spi"
  config PARAM_SELECTOR_SPI_BUS
    default "spi"
  config PARAM_IDLER_SPI_BUS
    default "spi"

  # ------------------------------------------------------------------
  # Defaults (gear/selector/idler motion hardware): stock Prusa MMU3
  # firmware (prusa-firmware-mmu src/config/config.h). With a 0.220 sense
  # resistor Klipper reproduces each stock TMC2130 register exactly:
  #   pulley   iRun 13 / iHold 0 -> 0.23 / 0.01, 8 microsteps, 19.147mm
  #   selector iRun 31 / iHold 0 -> 0.53 / 0.01, 8 microsteps, SGT 3
  #   idler    iRun 31 / iHold 5 -> 0.53 / 0.10, 16 microsteps, SGT 7
  #   all spreadCycle (.stealth = false); homing selector 30mm/s, idler
  #   265deg/s = 29.4 units/s
  # Movement speeds are NOT stock (see the gear/selector speed notes): the
  # Klipper MCU's move queue on the ATmega32U4 can't take Prusa's 95mm/s.
  # Rotation distances vary per unit: calibrate them.
  # ------------------------------------------------------------------

  config PARAM_GEAR_SENSE_RESISTOR
    default 0.220
  config PARAM_SELECTOR_SENSE_RESISTOR
    default 0.220

  config PARAM_GEAR_GEAR_RATIO
    default "1:1"
  config PARAM_GEAR_ROTATION_DISTANCE
    default 19.147
  config PARAM_GEAR_RUN_CURRENT
    default 0.23
  config PARAM_GEAR_HOLD_CURRENT
    default 0.01
  config PARAM_GEAR_MICROSTEPS
    default 8
  config PARAM_GEAR_STEALTHCHOP
    default 0		# Stock: always spreadCycle
  config PARAM_GEAR_STALLGUARD_THRESHOLD
    default 8
  config PARAM_GEAR_FREEWHEEL
    default 1		# Stock tmc2130_freewheel (only acts in stealthChop with IHOLD 0)
  config PARAM_GEAR_HOMING_SPEED
    default 30

  config PARAM_SELECTOR_GEAR_RATIO
    default "1:1"
  config PARAM_SELECTOR_ROTATION_DISTANCE
    default 8
  config PARAM_SELECTOR_RUN_CURRENT
    default 0.53
  config PARAM_SELECTOR_HOLD_CURRENT
    default 0.01
  config PARAM_SELECTOR_MICROSTEPS
    default 8
  config PARAM_SELECTOR_STEALTHCHOP
    default 0		# Stock: always spreadCycle (StallGuard needs it while homing)
  config PARAM_SELECTOR_STALLGUARD_THRESHOLD
    default 3
  config PARAM_SELECTOR_ACCEL
    default 1200
  config PARAM_SELECTOR_HOMING_SPEED
    default 30
    help
      Stock selectorHomingFeedrate. StallGuard needs medium motor speed:
      the stock SGT 3 is tuned for this speed, and much faster (60mm/s)
      pushes the back-EMF too high for a stall to register.

  config PARAM_SELECTOR_MOVE_SPEED
    default 20
    help
      Not stock (45mm/s): Klipper streams every step to the ATmega32U4,
      whose move queue overflowed on fast gate selection moves combined
      with the shift register writes ("Move queue overflow", verified on
      a live MMU3).

  # ------------------------------------------------------------------
  # Gear move speeds for the MMU3's ATmega32U4 (2.5KB RAM, ~115 move
  # queue nodes). Klipper's queue_step compression can only group ~2-4
  # steps per command through the acceleration phase, so the accel-phase
  # step budget (v^2 / 2a * steps_per_mm) must stay small. With the gear
  # at 165 steps/mm that means keeping v^2/2a under ~0.7mm; the generic
  # 100mm/s / accel 100 defaults make the accel phase 50mm long and shut
  # the MCU down on every gear move ("Move queue overflow" -- verified
  # on the live MMU3: 25mm/s at accel 50 fails, accel >= ~400 passes).
  # Cruise compression is excellent, so only the accel/decel phases pay.

  config PARAM_GEAR_LOAD_SPEED
    default 25
    help
      Bowden load speed for the MMU3 AVR. v^2/2a = 0.39mm at accel 800
      keeps the accel-phase step burst within the move queue budget.
  config PARAM_GEAR_LOAD_ACCEL
    default 800
  config PARAM_GEAR_UNLOAD_SPEED
    default 25
  config PARAM_GEAR_UNLOAD_ACCEL
    default 800
  config PARAM_GEAR_SHORT_MOVE_SPEED
    default 30
    help
      Short move speed for the MMU3 AVR (accel phase 0.56mm at accel 800).
  config PARAM_GEAR_SHORT_MOVE_ACCEL
    default 800

  config PARAM_IDLER_GEAR_RATIO
    default "1:1"
  config PARAM_IDLER_ROTATION_DISTANCE
    default 40
    help
      The idler is a rotating barrel driven 1:1 by the motor through a
      metal coupler. The generic 128 placeholder made the 40mm homing
      search only 12.5mm of real travel so the stop was never reached.
      Verified working at 40 on the live MMU3 (matches the original
      pre-port config value).
  config PARAM_IDLER_RUN_CURRENT
    default 0.53
  config PARAM_IDLER_HOLD_CURRENT
    default 0.10
  config PARAM_IDLER_MICROSTEPS
    default 16
    help
      Stock idler mRes. The idler offsets are in units of 1/40 turn at
      rotation_distance 40 (9 degrees each), matching Prusa's angles.
  config PARAM_IDLER_STEALTHCHOP
    default 0		# Stock: always spreadCycle
  config PARAM_IDLER_SGT
    default 7
    help
      Stock idler sg_thrs, tuned by Prusa for homing at 265deg/s against
      the end Prusa firmware homes to (the same end as here).
  config PARAM_IDLER_HOMING_SPEED
    default 29.4		# Stock 265deg/s at 9deg per unit

  # MMU3 has no purge bucket/waste chute of its own -- the shipped standalone
  # purge macro just dumps filament in place wherever the toolhead happens to
  # be parked. Default to letting the slicer's wipe tower handle purging
  # instead (remember to enable it in the slicer if you rely on this default).
  config PARAM_FORCE_PURGE_STANDALONE
    default 0

  config CUSTOM_LED_SETUP
    def_bool y

  source "Kconfig.capabilities"

endif
